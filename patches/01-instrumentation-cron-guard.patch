+// Télémétrie de production (ÉTEINTE par défaut). NEXT_PUBLIC_TRACE_PROD est inlinée à la COMPILATION : absente, ce bloc est
+// éliminé et l'enregistreur n'est même pas empaqueté. Présente, il se charge quand le navigateur est au repos, puis demande
+// au serveur (GET /api/telemetry) s'il doit enregistrer — le serveur peut répondre non.
+if (typeof window !== "undefined" && process.env.NEXT_PUBLIC_TRACE_PROD === "1") {
+  const demarrer = () => { void import("@/app/lib/trace/prod/client").then((m) => m.startProdRecorder()).catch(() => { /* jamais bloquer la page */ }); };
+  const ric = (window as unknown as { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void }).requestIdleCallback;
+  if (typeof ric === "function") ric(demarrer, { timeout: 4000 }); else window.setTimeout(demarrer, 2500);
+}
+
 /**
  * Instrumente les navigations App Router (convention @sentry/nextjs v9+).

diff --git a/instrumentation.ts b/instrumentation.ts
index c5b2e3a..45ab98f 100644
--- a/instrumentation.ts
+++ b/instrumentation.ts
@@ -6,3 +6,22 @@ export async function register() {
     await import("./sentry.edge.config");
   }
 }
+
+/**
+ * Erreurs non gérées vues par Next → télémétrie de production.
+ * INERTE tant que TRACE_PROD_ENABLED n'est pas « 1 » : la première ligne rend la main sans rien charger.
+ * Ne doit JAMAIS avoir d'effet sur la requête : tout est enveloppé et le résultat est ignoré.
+ */
+export async function onRequestError(
+  err: unknown,
+  request: { path: string; method: string },
+  context: { routePath?: string },
+) {
+  if (process.env.NEXT_RUNTIME !== "nodejs" || process.env.TRACE_PROD_ENABLED !== "1") return;
+  try {
+    const { reportServerError } = await import("@/app/lib/trace/prod/server");
+    await reportServerError(err, request, context);
+  } catch {
+    /* jamais d'effet sur la requête */
+  }
+}

# ════════════════════════════════════════════════════════════════════════════
# TÉLÉMÉTRIE ImmoAdmin — variables d'environnement (à ajouter dans Vercel → Settings → Environment Variables)
#
# ⚠ Ce fichier ne contient AUCUN secret : ce sont des modèles. Générez vos propres valeurs.
# ⚠ Un changement de variable ne s'applique qu'au PROCHAIN déploiement (sauf l'interrupteur Redis, voir plus bas).
# ⚠ Commencez par l'environnement PREVIEW, jamais directement Production.
#
# Génération d'un secret (n'importe quelle machine avec Node) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ════════════════════════════════════════════════════════════════════════════

# ── Étape 0 : DORMANT (valeurs par défaut — c'est ce qu'on déploie d'abord) ──
# Ne rien définir, ou :
TRACE_PROD_ENABLED=0
# NEXT_PUBLIC_TRACE_PROD n'est PAS défini : sans lui, le code de l'enregistreur n'est même pas dans le bundle du navigateur.

# ── Étape 1 : « fondateurs » (Preview d'abord, puis Production) ──────────────
TRACE_PROD_ENABLED=1
NEXT_PUBLIC_TRACE_PROD=1                  # lu à la COMPILATION : exige un nouveau déploiement
TRACE_PSEUDONYM_SECRET=                   # 64 caractères hexadécimaux, NOUVEAU secret. Sans lui l'enregistreur refuse de démarrer.
TRACE_PROD_ALLOWLIST=                     # courriels séparés par des virgules : seuls ces comptes sont enregistrés
TRACE_SINK=supabase
TRACE_SUPABASE_URL=                       # projet Supabase DÉDIÉ à la télémétrie (PAS la base principale)
TRACE_SUPABASE_SERVICE_KEY=               # clé service-role de ce projet dédié
TRACE_PROD_SAMPLE_PCT=100                 # tant que l'allowlist est petite : tout enregistrer

# ── Étape 2+ : élargissement ────────────────────────────────────────────────
# TRACE_PROD_ALLOWLIST=                   # vider pour ouvrir à tous
# TRACE_PROD_SAMPLE_PCT=10                # % de sessions qui enregistrent le trafic normal (les erreurs sont TOUJOURS envoyées)

# ── Niveau B : clics, navigation, messages — seulement après décision juridique ─
# TRACE_PROD_TIER_B=1                     # reste conditionné au consentement cookies de chaque visiteur (vérifié dans le navigateur)
# TRACE_PROD_CLICK_TEXT=0                 # 1 = enregistrer le texte des boutons (déconseillé : peut contenir un nom)
# TRACE_PROD_MESSAGE_TEXT=0               # 1 = enregistrer le texte des messages affichés (déconseillé)

# ── Optionnel ───────────────────────────────────────────────────────────────
TRACE_RETENTION_DAYS=14                   # 1 à 90 ; purge quotidienne par /api/cron/telemetry-purge
# TRACE_PROD_ERROR_MESSAGE=0              # 0 = ne garder que le type et l'emplacement de l'erreur, jamais son texte

# ── Lecture par la console du développeur (laisser VIDE pour désactiver la lecture) ──
TRACE_EXPORT_TOKEN=                       # 24+ caractères aléatoires. Absent = la route /api/telemetry/export renvoie 404.

# ── Interrupteur d'urgence IMMÉDIAT (sans redéploiement) ─────────────────────
# Dans Upstash Redis (déjà utilisé par le projet), créez la clé  trace:enabled  avec la valeur  0
# → tous les enregistreurs s'arrêtent en ≤ 60 s. Supprimer la clé (ou la mettre à 1) les rallume.
